<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".TicTacToeActivity">

    <TextView
        android:id="@+id/textViewStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="Player X's turn"
        android:textAppearance="?attr/textAppearanceHeadline6"
        app:layout_constraintBottom_toTopOf="@+id/gridLayoutTicTacToe"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/gridLayoutTicTacToe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:columnCount="3"
        app:rowCount="3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/button00"
            style="@style/Widget.App.Button.TicTacToe"
            android:onClick="onCellClick"/>
        <Button
            android:id="@+id/button01"
            style="@style/Widget.App.Button.TicTacToe"
            android:onClick="onCellClick"/>
        <Button
            android:id="@+id/button02"
            style="@style/Widget.App.Button.TicTacToe"
            android:onClick="onCellClick"/>

        <Button
            android:id="@+id/button10"
            style="@style/Widget.App.Button.TicTacToe"
            android:onClick="onCellClick"/>
        <Button
            android:id="@+id/button11"
            style="@style/Widget.App.Button.TicTacToe"
            android:onClick="onCellClick"/>
        <Button
            android:id="@+id/button12"
            style="@style/Widget.App.Button.TicTacToe"
            android:onClick="onCellClick"/>

        <Button
            android:id="@+id/button20"
            style="@style/Widget.App.Button.TicTacToe"
            android:onClick="onCellClick"/>
        <Button
            android:id="@+id/button21"
            style="@style/Widget.App.Button.TicTacToe"
            android:onClick="onCellClick"/>
        <Button
            android:id="@+id/button22"
            style="@style/Widget.App.Button.TicTacToe"
            android:onClick="onCellClick"/>

    </androidx.gridlayout.widget.GridLayout>

    <Button
        android:id="@+id/buttonReset"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Reset Game"
        android:onClick="resetGame"
        app:layout_constraintTop_toBottomOf="@+id/gridLayoutTicTacToe"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>